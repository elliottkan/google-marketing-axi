{
  "name": "google-marketing-axi",
  "version": "0.1.0",
  "description": "AXI-compliant wrapper around the GA4 and Google Tag Manager APIs - TOON output, cached property/container defaults, diffed GTM writes, exit codes you can gate on",
  "type": "module",
  "keywords": ["google-analytics", "ga4", "google-tag-manager", "gtm", "cli", "agent", "axi", "toon"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/elliottkan/google-marketing-axi.git" },
  "homepage": "https://github.com/elliottkan/google-marketing-axi#readme",
  "bugs": "https://github.com/elliottkan/google-marketing-axi/issues",
  "bin": { "google-marketing-axi": "./dist/bin/google-marketing-axi.js" },
  "files": ["dist", "skills/google-marketing-axi", "LICENSE", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/google-marketing-axi.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
